# Configuration locale de B2. Copier ce fichier vers `.env` et ne renseigner
# que la clé. Le `.env` réel ne doit jamais être versionné.
B2_API_KEY=
# NVIDIA_API_KEY=
# INDUSTRIAL_API_KEY=
B2_API_BASE=https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=
# INDUSTRIAL_API_BASE=
B2_MODEL=nvidia/nemotron-3-super-120b-a12b
B2_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
B2_ENABLE_THINKING=true
B2_REASONING_BUDGET=8192
B2_TEMPERATURE=0.1
B2_LLM_TIMEOUT=180.0
B2_NETWORK_TIMEOUT=25.0
B2_MODEL_TOKENS=256000

# Debug local uniquement : utiliser un nouveau dossier à chaque run.
# Le corpus brut est ignoré par Git, puis rejoué hors réseau.
# B2_REPLAY_DIR=.replay/nv1t05bd-norel-01

B2_SEARXNG_URL=http://localhost:8080
# SEARXNG_URL=
# INDUSTRIAL_SEARX_URL=
B2_MAX_RESULTS_PER_QUERY=12
# Domaines multi-marques lisibles ; separer les domaines par des virgules.
# Distri B est volontairement absent : ses pages B2 renvoient 403.
B2_DISTRIBUTOR_DOMAINS=distributeur-a.example,distributeur-b.example,distributeur-c.example,distributeur-d.example
B2_ADAPTIVE_MAX_WAVES=4
B2_ADAPTIVE_QUERIES_PER_WAVE=3
B2_ADAPTIVE_ENGINE_ATTEMPTS=3
B2_ADAPTIVE_PAGES_PER_WAVE=12
B2_MIN_COMPATIBILITY_PERCENT=75

B2_MAX_SCRAPER_WORKERS=2
# Les audits LLM n'occupent qu'une socket : les borner comme les
# navigateurs les serialiserait sans gain de memoire.
B2_MAX_ANALYSIS_WORKERS=2
B2_SCRAPER_RATE_LIMIT_DELAY=0.5
B2_BACKEND=playwright
B2_HEADLESS=true
B2_VERBOSE=true

# Cache de pages : une page recuperee une fois est relue depuis le disque au
# lieu d'etre redemandee a un site qui peut repondre 403 au run suivant.
# Un dossier vide ou une duree de vie nulle desactive le cache.
B2_PAGE_CACHE_DIR=.cache_pages
B2_PAGE_CACHE_TTL_HOURS=168.0

# Domaines supplementaires ecartes avant ouverture. Complete la
# liste par defaut (Stack Overflow, encyclopedies, reseaux sociaux,
# emploi) au lieu de la remplacer.
B2_EXCLUDED_DOMAINS=

# Connaissance de marques (domaines officiels, alias courts). Le fichier
# livre ne contient que des exemples ; renseignez le votre ici.
# B2_MARQUES_CONNUES=marques.exemple.json
